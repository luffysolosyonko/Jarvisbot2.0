# Copy to app/.env.local for development. Never commit the real file.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone with the
# build. Only put public client config here, never API keys for paid services.

# Jarvis API origin (no trailing slash, no /api/v1; the client adds it).
# The web build (npm run web) reaches the API on localhost. On the Android
# emulator either run `adb reverse tcp:8000 tcp:8000` once per boot so
# localhost works there too, or use http://10.0.2.2:8000 (the emulator's alias
# for the host). Leave blank to pick the right one per platform.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Firebase web app config (Firebase console > Project settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-me

# Google sign-in on Android/iOS (optional). The web build doesn't need it: it
# uses a Firebase popup. Leave blank and the native app still works with email
# sign-in and "Try the demo"; the Google button explains it isn't set up.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
