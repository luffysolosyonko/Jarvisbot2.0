# Copy to api/.env for local development. Never commit the real file.
# docker compose reads this file too and overrides DATABASE_URL and
# GOOGLE_APPLICATION_CREDENTIALS for the container.

# Runtime
ENV=local
LOG_LEVEL=info
# CORS isn't needed for the native app. Comma-separated origins, if any.
CORS_ORIGINS=

# Database (SQLAlchemy URL). Matches the Postgres in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis

# Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account key, gitignored, relative to api/ (see docs/SETUP.md section 5).
# Needed to mint "Try the demo" tokens; ID token verification works without it.
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json

# "Try the demo": the fixed Firebase UID of the demo account. Empty disables it.
DEMO_UID=jarvis-demo
DEMO_TOKEN_PER_MIN=5
DEMO_TOKEN_PER_DAY=50

# Rate limits (requests per minute per user)
RATE_LIMIT_PARSE_PER_MIN=60
RATE_LIMIT_ASK_PER_MIN=10

# Ask Jarvis. Without a key, Ask Jarvis returns a clear "not configured" error.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=15
ASK_DAILY_TOKEN_CAP=50000
ASK_DEMO_DAILY_TOKEN_CAP=10000
