# Copy to api/.env for local development. Never commit the real file.
# In production these come from Cloud Run env vars and Secret Manager.

# Runtime
ENV=local
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8081

# Database (SQLAlchemy URL). Local Docker Postgres or SQLite for tests.
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis

# Firebase Admin (token verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local only: path to a service account key OUTSIDE the repo. On Cloud Run,
# leave unset; the service's own identity is used (no key files).
GOOGLE_APPLICATION_CREDENTIALS=

# LLM (Ask Jarvis)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=sk-ant-replace-me
ASK_DAILY_TOKEN_CAP=50000

# Rate limits (requests per minute per user)
RATE_LIMIT_PARSE_PER_MIN=60
RATE_LIMIT_ASK_PER_MIN=10

# Demo account
DEMO_USER_EMAIL=demo@example.com
DEMO_RESET_TOKEN=replace-with-a-long-random-string
