# Copy to web/.env.local for development. Never commit the real file.
# VITE_* values are bundled into the page and visible to anyone who loads it.
# Only public client config goes here, never API keys for paid services.

# Jarvis API origin (no trailing slash, no /api/v1; the client adds it).
VITE_API_URL=http://localhost:8000

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-me
